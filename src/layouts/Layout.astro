---
import '../styles/global.css';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import BrochureModal from '../components/BrochureModal.astro';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "HKM Venture Global — Pharmaceutical, Chemical & Frozen Food Exporter from India",
  description = 'India-based sourcing and export partner for healthcare & pharmaceuticals, chemicals and frozen foods. WHO-GMP certified manufacturing partners, full documentation and registration support for importers in Ghana and Africa.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://hkmventureglobal.com').href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HKM Venture Global" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://hkmventureglobal.com/logo.png" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌐</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500&family=EB+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Manrope:wght@300;400;500;600&family=Montserrat:wght@500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <WhatsAppFloat />
    <BrochureModal />
    <script>
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        });
      }, { rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
