---
import { company, verticals, waLink } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <span class="footer-logo">HKM</span>
        <span class="footer-logo-sub">Venture Global</span>
        <p class="footer-tagline">Connecting Markets.<br/><em>Delivering Trust.</em></p>
        <address class="footer-contact">
          <span>{company.address}</span>
          <a href={`mailto:${company.email}`}>{company.email}</a>
          <a href={`tel:${company.phone.replace(/\s/g, '')}`}>{company.phone}</a>
          <a href={waLink()} target="_blank" rel="noopener">WhatsApp us →</a>
        </address>
      </div>
      <nav class="footer-nav">
        <div class="footer-col">
          <span class="label footer-col-title">Company</span>
          <ul>
            <li><a href="/about">About Us</a></li>
            <li><a href="/about#founders">Founding Members</a></li>
            <li><a href="/#process">Our Process</a></li>
            <li><a href="/contact">Contact</a></li>
            <li><a href="#" data-brochure>Download Brochure</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <span class="label footer-col-title">Products</span>
          <ul>
            {verticals.map((v) => (
              <li><a href={`/products/${v.slug}`}>{v.short}</a></li>
            ))}
            <li><a href="/products">All Products</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <span class="label footer-col-title">Services</span>
          <ul>
            <li><a href="/#services">Export Management</a></li>
            <li><a href="/#services">Third-Party Manufacturing</a></li>
            <li><a href="/#services">Customs Clearance</a></li>
            <li><a href="/#services">Logistics & Freight</a></li>
          </ul>
        </div>
      </nav>
    </div>
    <div class="footer-bottom">
      <p class="footer-copy">© {year} HKM Venture Global. All Rights Reserved. | {company.city}</p>
      <div class="footer-legal">
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/terms">Terms &amp; Conditions</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #060505;
    border-top: 1px solid rgba(229,193,136,0.08);
    padding: 80px 0 40px;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 80px;
    padding-bottom: 64px;
    border-bottom: 1px solid rgba(229,193,136,0.08);
    margin-bottom: 40px;
  }

  .footer-brand { display: flex; flex-direction: column; gap: 6px; }

  .footer-logo {
    font-family: var(--font-label);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: 0.25em;
    color: var(--hero-glow);
    line-height: 1;
  }

  .footer-logo-sub {
    font-family: var(--font-body);
    font-size: 10px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(229,193,136,0.35);
    margin-bottom: 16px;
  }

  /* Same treatment as the home page tagline: white line + gold italic line */
  .footer-tagline {
    font-family: var(--font-display);
    font-size: 22px;
    color: var(--hero-text);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .footer-tagline em { font-style: italic; color: var(--hero-glow); }

  .footer-contact {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 24px;
    font-size: 13px;
    line-height: 1.6;
    color: rgba(243,240,236,0.45);
  }
  .footer-contact a { color: rgba(243,240,236,0.55); text-decoration: none; transition: color 0.2s; }
  .footer-contact a:hover { color: var(--hero-glow); }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }

  .footer-col-title {
    display: block;
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.18em;
    margin-bottom: 22px;
  }

  .footer-col ul { list-style: none; display: flex; flex-direction: column; gap: 12px; }

  .footer-col a {
    font-size: 13px;
    color: rgba(243,240,236,0.4);
    text-decoration: none;
    transition: color 0.2s;
    letter-spacing: 0.02em;
  }
  .footer-col a:hover { color: var(--hero-glow); }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .footer-copy {
    font-size: 12px;
    color: rgba(243,240,236,0.25);
    letter-spacing: 0.04em;
  }

  .footer-legal { display: flex; gap: 24px; }

  .footer-legal a {
    font-size: 11px;
    color: rgba(243,240,236,0.25);
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: color 0.2s;
  }
  .footer-legal a:hover { color: rgba(229,193,136,0.5); }

  @media (max-width: 900px) {
    .footer-top  { grid-template-columns: 1fr; gap: 40px; }
    .footer-nav  { grid-template-columns: 1fr 1fr; }
    .footer-bottom { flex-direction: column; gap: 16px; align-items: flex-start; }
  }
</style>
