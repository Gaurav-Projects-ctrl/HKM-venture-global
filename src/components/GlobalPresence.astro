---
/**
 * "Exporting to 10+ countries" — global export network section with the flags of
 * the West & Central African markets HKM is expanding into.
 * Countries come from `presence` in src/data/site.ts; flags are drawn as inline SVG (no image downloads).
 */
import { presence, registeredMarkets } from '../data/site';

// Number of countries HKM exports to (shown in the heading and the stat box)
const exportCount = '10+';

// Simple tricolour flags (3:2). h = horizontal stripes, v = vertical stripes.
const flags: Record<string, { dir: 'h' | 'v'; colors: string[]; star?: boolean }> = {
  gh: { dir: 'h', colors: ['#CE1126', '#FCD116', '#006B3F'], star: true },
  ng: { dir: 'v', colors: ['#008751', '#FFFFFF', '#008751'] },
  ci: { dir: 'v', colors: ['#F77F00', '#FFFFFF', '#009E60'] },
  sl: { dir: 'h', colors: ['#1EB53A', '#FFFFFF', '#0072C6'] },
  gn: { dir: 'v', colors: ['#CE1126', '#FCD116', '#009460'] },
  ml: { dir: 'v', colors: ['#14B53A', '#FCD116', '#CE1126'] },
  ga: { dir: 'h', colors: ['#009E60', '#FCD116', '#3A75C4'] },
};
const star = '15.00,6.60 15.79,8.91 18.23,8.95 16.28,10.42 17.00,12.75 15.00,11.35 13.00,12.75 13.72,10.42 11.77,8.95 14.21,8.91';

const regions = [
  { name: 'Expanding across West & Central Africa:', list: presence.map((p) => p.name) },
];

const stats = [
  { num: exportCount, label: 'Export countries', accent: true },
  { num: '5000+', label: 'Products' },
  { num: '3', label: 'Industry sectors' },
  { num: '24h', label: 'Enquiry response' },
];
---
<section class="gp section-pad" aria-labelledby="gp-title">
  <div class="container">
    <div class="gp-grid">
      <div class="gp-text reveal">
        <span class="label gp-label">Global Export Network</span>
        <h2 class="gp-title" id="gp-title">
          Exporting to <span class="gp-accent">{exportCount} Countries</span><br/>Expanding Across West &amp; Central Africa
        </h2>
        <p class="gp-body">
          Indian medicines, chemicals and foods sourced by HKM reach importers and distributors in {exportCount} countries — and we are now expanding across West and Central Africa.
        </p>
        <ul class="gp-regions">
          {regions.map((r) => (
            <li><span class="gp-dot" aria-hidden="true"></span><strong>{r.name}</strong> {r.list.map((c, i) => <><span class="gp-nw">{c}</span>{i < r.list.length - 1 && ' · '}</>)}</li>
          ))}
        </ul>
      </div>

      <div class="gp-stats reveal">
        {stats.map((s) => (
          <div class:list={['gp-stat', { 'gp-stat--accent': s.accent }]}>
            <span class="gp-stat-num">{s.num}</span>
            <span class="label gp-stat-label">{s.label}</span>
          </div>
        ))}
      </div>
    </div>

    <ul class="gp-flags reveal" aria-label="West and Central African markets">
      {presence.map((p) => {
        const f = flags[p.code];
        return (
          <li class="gp-flag">
            <svg viewBox="0 0 30 20" width="54" height="36" role="img" aria-label={`Flag of ${p.name}`}>
              {f.colors.map((c, i) =>
                f.dir === 'h'
                  ? <rect x="0" y={(i * 20) / 3} width="30" height={20 / 3 + 0.05} fill={c} />
                  : <rect x={i * 10} y="0" width="10.05" height="20" fill={c} />
              )}
              {f.star && <polygon points={star} fill="#000" />}
            </svg>
            <span>{p.name}</span>
          </li>
        );
      })}
    </ul>

    <div class="gp-markets reveal">
      <h3 class="gp-markets-title">Countries Covered</h3>
      <p class="gp-markets-sub">Registered markets by region</p>
      <div class="gp-markets-grid">
        {registeredMarkets.map((r) => (
          <div class="gp-market" style={`--cols:${r.cols};--rows:${Math.ceil(r.countries.length / r.cols)}`}>
            <h4 class="label gp-market-region">{r.region} <span>({r.countries.length})</span></h4>
            <ul class="gp-market-list">
              {[...r.countries].sort((a, b) => a.localeCompare(b)).map((c) => <li>{c}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .gp { background: var(--inverse-surface); color: var(--hero-text); }

  .gp-grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: 80px; align-items: center; }

  .gp-label { color: var(--inverse-primary); display: block; margin-bottom: 20px; }
  .gp-title { font-size: clamp(34px, 4.2vw, 54px); line-height: 1.1; color: var(--hero-text); margin-bottom: 24px; }
  .gp-accent { color: var(--inverse-primary); font-style: italic; }
  .gp-body { font-size: 15.5px; line-height: 1.8; color: rgba(245, 240, 232, 0.72); max-width: 540px; margin-bottom: 32px; }

  .gp-regions { list-style: none; display: flex; flex-direction: column; gap: 14px; }
  .gp-regions li { font-size: 14px; line-height: 1.7; color: rgba(245, 240, 232, 0.62); padding-left: 22px; position: relative; }
  .gp-regions strong { color: var(--hero-text); font-weight: 600; margin-right: 6px; }
  .gp-dot { position: absolute; left: 0; top: 8px; width: 8px; height: 8px; border: 1px solid var(--inverse-primary); }

  .gp-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .gp-stat {
    padding: 30px 20px;
    text-align: center;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(229, 193, 136, 0.14);
    display: flex; flex-direction: column; gap: 8px; align-items: center;
  }
  .gp-stat--accent { background: var(--primary); border-color: var(--primary); }
  .gp-stat-num { font-family: var(--font-display); font-size: 40px; line-height: 1; color: var(--hero-text); }
  .gp-stat-label { color: rgba(245, 240, 232, 0.6); font-size: 9px; }
  .gp-stat--accent .gp-stat-label { color: rgba(255, 255, 255, 0.85); }

  .gp-flags {
    list-style: none;
    display: flex; flex-wrap: wrap; justify-content: center; gap: 28px 40px;
    margin-top: 72px; padding-top: 48px;
    border-top: 1px solid rgba(229, 193, 136, 0.14);
  }
  .gp-flag { display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .gp-flag svg { display: block; border-radius: 3px; box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.15), 0 6px 16px rgba(0, 0, 0, 0.3); transition: transform 0.3s ease; }
  .gp-flag:hover svg { transform: translateY(-3px); }
  .gp-flag span { font-size: 12px; color: rgba(245, 240, 232, 0.7); letter-spacing: 0.02em; }

  .gp-markets { margin-top: 64px; text-align: center; }
  .gp-markets-title { font-family: var(--font-display); font-weight: 400; font-size: clamp(26px, 2.6vw, 34px); color: var(--hero-text); }
  .gp-markets-sub { font-size: 14px; color: rgba(245, 240, 232, 0.55); margin-top: 6px; }
  .gp-nw { white-space: nowrap; }
  .gp-markets-grid { display: grid; grid-template-columns: 3fr 2fr; gap: 14px; margin-top: 32px; text-align: left; }
  .gp-market { padding: 30px 32px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(229, 193, 136, 0.14); }
  .gp-market:first-child { grid-column: 1 / -1; }
  .gp-market-region { color: var(--inverse-primary); font-size: 11px; margin-bottom: 20px; padding-bottom: 14px; border-bottom: 1px solid rgba(229, 193, 136, 0.14); }
  .gp-market-region span { color: rgba(245, 240, 232, 0.45); }
  .gp-market-list { list-style: none; display: grid; grid-template-columns: repeat(var(--cols, 2), 1fr); grid-auto-flow: column; grid-template-rows: repeat(var(--rows), auto); gap: 10px 24px; }
  .gp-market-list li { font-size: 14px; line-height: 1.5; color: rgba(245, 240, 232, 0.78); padding-left: 16px; position: relative; }
  .gp-market-list li::before { content: ''; position: absolute; left: 0; top: 0.72em; width: 6px; height: 1px; background: var(--inverse-primary); }

  @media (max-width: 900px) {
    .gp-markets-grid { grid-template-columns: 1fr; }
    .gp-market { padding: 26px 22px; }
    .gp-market-list { grid-template-columns: 1fr 1fr; grid-auto-flow: row; grid-template-rows: none; }
    .gp-grid { grid-template-columns: 1fr; gap: 48px; }
    .gp-flags { gap: 24px 26px; margin-top: 56px; padding-top: 40px; }
  }
  @media (max-width: 480px) {
    .gp-stat { padding: 24px 12px; }
    .gp-stat-num { font-size: 32px; }
    .gp-flag svg { width: 44px; height: 30px; }
    .gp-flag span { font-size: 11px; }
  }
</style>
