---
/**
 * Full-bleed background photo for a dark section. The parent section must be
 * position:relative; overflow:hidden, and its content must sit above (z-index:1).
 * Renders nothing if /public/images/<name>.jpg is missing.
 */
import { hasImage, imgSrc, srcsets } from '../lib/images';

interface Props {
  name: string;
  position?: string;
  /** Overlay darkness 0–1 (default 0.72) */
  shade?: number;
}
const { name, position = 'center', shade = 0.72 } = Astro.props;
const show = hasImage(name);
const set = show ? srcsets('images', name) : { avif: '', webp: '' };
---
{show && (
  <div class="sbg" aria-hidden="true" style={`--sbg-shade:${shade}`}>
    <picture>
      {set.avif && <source type="image/avif" srcset={set.avif} sizes="100vw" />}
      {set.webp && <source type="image/webp" srcset={set.webp} sizes="100vw" />}
      <img src={imgSrc(name)} alt="" loading="lazy" decoding="async" style={`object-position:${position}`} />
    </picture>
    <div class="sbg-shade"></div>
  </div>
)}

<style>
  .sbg { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .sbg picture { display: contents; }
  .sbg img {
    width: 100%; height: 100%;
    object-fit: cover;
    filter: saturate(0.85);
  }
  .sbg-shade {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse at center, rgba(8,7,6, calc(var(--sbg-shade) - 0.12)) 0%, rgba(8,7,6, var(--sbg-shade)) 70%),
      linear-gradient(180deg, rgba(8,7,6,0.35) 0%, rgba(8,7,6,0) 30%, rgba(8,7,6,0) 70%, rgba(8,7,6,0.45) 100%);
  }
</style>
