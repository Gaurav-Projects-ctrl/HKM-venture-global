---
/**
 * Photo placed inside a section column. Renders nothing if
 * /public/images/<name>.jpg is missing, so the layout falls back to text-only.
 */
import { hasImage, imgSrc, srcsets } from '../lib/images';

interface Props {
  name: string;
  alt: string;
  /** CSS aspect-ratio, e.g. '3 / 2', '16 / 9' */
  ratio?: string;
  /** object-position for cropping, e.g. 'center', '70% 40%' */
  position?: string;
  class?: string;
  /** Stretch to the height of its column instead of using a fixed ratio (desktop only) */
  fill?: boolean;
}
const { name, alt, ratio = '3 / 2', position = 'center', class: cls, fill = false } = Astro.props;
const show = hasImage(name);
const set = show ? srcsets('images', name) : { avif: '', webp: '' };
// Column is ~half the page on desktop, full width on phones
const sizes = '(max-width: 900px) calc(100vw - 40px), 560px';
---
{show && (
  <figure class:list={['simg', { 'simg--fill': fill }, cls]} style={`--simg-ratio:${ratio}`} data-simg>
    <picture>
      {set.avif && <source type="image/avif" srcset={set.avif} sizes={sizes} />}
      {set.webp && <source type="image/webp" srcset={set.webp} sizes={sizes} />}
      <img src={imgSrc(name)} alt={alt} loading="lazy" decoding="async" style={`object-position:${position}`} />
    </picture>
  </figure>
)}

<style>
  .simg {
    position: relative;
    margin: 0;
    overflow: hidden;
    aspect-ratio: var(--simg-ratio);
    background: transparent;
  }
  /* Fill mode: grows to match the neighbouring text column */
  .simg--fill { aspect-ratio: auto; flex: 1 1 auto; min-height: 360px; }
  .simg--fill img { position: absolute; inset: 0; }
  @media (max-width: 900px) {
    .simg--fill { aspect-ratio: 4 / 3; min-height: 0; flex: none; width: 100%; }
  }
  .simg picture { display: contents; }
  .simg img {
    display: block;
    width: 100%; height: 100%;
    object-fit: cover;
    filter: saturate(0.9);
    transform: scale(1.12);
    transition:
      transform 1.6s cubic-bezier(0.2, 0.7, 0.2, 1),
      clip-path 1.1s cubic-bezier(0.7, 0, 0.2, 1);
  }
  /* Reveal: photo wipes up into view as the section scrolls in.
     (Clip the <img>, not the <figure> — a fully clipped target never reports as visible.) */
  :global(.js) .simg img { clip-path: inset(100% 0 0 0); }
  :global(.js) .simg.in img { clip-path: inset(0 0 0 0); }
  .simg.in img { transform: scale(1); }
  /* Gentle zoom on hover (desktop) */
  @media (hover: hover) {
    .simg.in:hover img { transform: scale(1.04); transition-duration: 0.9s; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .simg img, :global(.js) .simg.in img { clip-path: none; transform: none; transition: none; }
  }
  :global(html:not(.js)) .simg img { transform: none; }
</style>

<script>
  const els = document.querySelectorAll<HTMLElement>('[data-simg]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { threshold: 0.2, rootMargin: '0px 0px -8% 0px' });
    els.forEach((el) => io.observe(el));
  } else {
    els.forEach((el) => el.classList.add('in'));
  }
</script>
