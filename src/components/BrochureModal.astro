---
<!--
  Brochure request pop-up. Any element with the attribute  data-brochure  opens it.
  The brochure is NOT on the website: the visitor's details are emailed to HKM (Web3Forms),
  and the sales team sends the brochure to them by email.
-->
<dialog id="brochure-modal" class="bro-modal" aria-labelledby="bro-title">
  <button class="bro-close" type="button" aria-label="Close" data-bro-close>×</button>

  <div class="bro-step" id="bro-step-form">
    <span class="label bro-over">Company Brochure</span>
    <h2 id="bro-title" class="bro-title">Request our <em>brochure</em></h2>
    <p class="bro-sub">
      Our products, quality standards and how we work. Share your details and our sales team will email the brochure to you.
    </p>
    <form id="brochure-form" class="bro-form" novalidate>
      <input type="checkbox" name="botcheck" style="display:none;" tabindex="-1" autocomplete="off" />
      <label class="bro-field">
        <span class="label">Full Name *</span>
        <input type="text" name="name" required autocomplete="name" placeholder="Your name" />
      </label>
      <div class="bro-row">
        <label class="bro-field">
          <span class="label">Email *</span>
          <input type="email" name="email" required autocomplete="email" placeholder="you@company.com" />
        </label>
        <label class="bro-field">
          <span class="label">Contact Number *</span>
          <input type="tel" name="phone" required autocomplete="tel" inputmode="tel" placeholder="+233 24 123 4567" />
        </label>
      </div>
      <label class="bro-field">
        <span class="label">Company</span>
        <input type="text" name="company" autocomplete="organization" placeholder="Your company (optional)" />
      </label>
      <p class="bro-error" id="bro-error" role="alert"></p>
      <button type="submit" class="btn btn-dark bro-submit">Request Brochure</button>
    </form>
  </div>

  <div class="bro-step bro-done" id="bro-step-done" hidden>
    <span class="bro-tick" aria-hidden="true">✓</span>
    <span class="label bro-over">Request received</span>
    <h2 class="bro-title">Thank you, <em id="bro-done-name"></em></h2>
    <p class="bro-sub">
      Our sales team will email the brochure to <strong id="bro-done-email"></strong> shortly, usually within one working day.
    </p>
    <button type="button" class="btn btn-dark" data-bro-close>Close</button>
  </div>
</dialog>

<style>
  .bro-modal {
    margin: auto;
    width: min(560px, calc(100vw - 32px));
    max-height: calc(100vh - 32px);
    border: 1px solid var(--outline-variant);
    border-radius: 4px;
    background: var(--surface);
    color: var(--on-surface);
    padding: 44px 40px 40px;
    box-shadow: 0 30px 80px rgba(0,0,0,0.35);
  }
  .bro-modal::backdrop { background: rgba(8, 7, 6, 0.7); backdrop-filter: blur(4px); }

  .bro-close {
    position: absolute;
    top: 14px; right: 18px;
    background: none; border: none;
    font-size: 28px; line-height: 1;
    color: var(--outline);
    cursor: pointer;
  }
  .bro-close:hover { color: var(--on-surface); }

  .bro-over { color: var(--primary); display: block; margin-bottom: 14px; }
  .bro-title { font-size: 36px; line-height: 1.1; letter-spacing: -0.02em; margin-bottom: 12px; }
  .bro-title em { font-style: italic; color: var(--primary); }
  .bro-sub { font-size: 14px; line-height: 1.7; color: var(--on-surface-variant); margin-bottom: 28px; }

  .bro-form { display: flex; flex-direction: column; gap: 20px; }
  .bro-row { display: flex; gap: 20px; }
  .bro-row > * { flex: 1; min-width: 0; }
  .bro-field { display: flex; flex-direction: column; gap: 6px; }
  .bro-field .label { font-size: 9px; letter-spacing: 0.18em; color: var(--outline); }
  .bro-field input {
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--outline-variant);
    padding: 9px 0;
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--on-surface);
    outline: none;
    border-radius: 0;
  }
  .bro-field input:focus { border-bottom-color: var(--primary); }
  .bro-field input.invalid { border-bottom-color: #ba1a1a; }
  .bro-error { font-size: 13px; color: #ba1a1a; min-height: 18px; }
  .bro-submit { align-self: flex-start; }
  .bro-done { text-align: left; }
  .bro-tick {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: 50%;
    background: var(--primary); color: #fff; font-size: 20px;
    margin-bottom: 20px;
  }
  .bro-done strong { color: var(--on-surface); font-weight: 600; overflow-wrap: anywhere; }

  @media (max-width: 600px) {
    .bro-modal { padding: 40px 22px 28px; }
    .bro-row { flex-direction: column; }
    .bro-title { font-size: 30px; }
  }
</style>

<script>
  import { sendLead } from '../lib/forms';
  import { trackLead } from '../lib/track';
  const EMAIL_TO = 'info@hkmventureglobal.com';
  const modal = document.getElementById('brochure-modal') as HTMLDialogElement;
  const form = document.getElementById('brochure-form') as HTMLFormElement;
  const err = document.getElementById('bro-error')!;

  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest('[data-brochure]');
    if (t) {
      e.preventDefault();
      modal.showModal();
    }
    if ((e.target as HTMLElement).closest('[data-bro-close]')) modal.close();
  });
  modal.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });

  form.querySelectorAll('input').forEach((i) =>
    i.addEventListener('input', () => { i.classList.remove('invalid'); err.textContent = ''; })
  );

  const stepForm = document.getElementById('bro-step-form')!;
  const stepDone = document.getElementById('bro-step-done')!;
  const reset = () => {
    form.reset();
    form.querySelectorAll('input').forEach((i) => i.classList.remove('invalid'));
    err.textContent = '';
    stepForm.hidden = false;
    stepDone.hidden = true;
  };
  modal.addEventListener('close', reset);

  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  const phoneOk = (v: string) => /^[+\d][\d\s().-]*$/.test(v) && (v.match(/\d/g) || []).length >= 7 && (v.match(/\d/g) || []).length <= 15;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
    const checks: [HTMLInputElement, boolean][] = [
      [f('name'), f('name').value.trim().length > 1],
      [f('email'), EMAIL_RE.test(f('email').value.trim())],
      [f('phone'), phoneOk(f('phone').value.trim())],
    ];
    const bad = checks.filter(([, ok]) => !ok).map(([el]) => el);
    bad.forEach((i) => i.classList.add('invalid'));
    if (bad.length) {
      err.textContent = 'Please enter your name, a valid email address and a contact number with country code.';
      bad[0].focus();
      return;
    }

    const btn = form.querySelector('.bro-submit') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Sending…';

    const d = Object.fromEntries(new FormData(form)) as Record<string, string>;
    // Honeypot ticked → a bot; show success, send nothing
    const ok = d.botcheck ? true : await sendLead(
      `Brochure request from ${d.name}${d.company ? ` (${d.company})` : ''}`,
      {
        name: d.name,
        email: d.email,
        phone: d.phone,
        company: d.company,
        message: 'Requested the company brochure. Please email the brochure to this contact.',
      },
    );

    btn.disabled = false;
    btn.textContent = 'Request Brochure';
    if (ok) {
      if (!d.botcheck) trackLead('brochure', { page: location.pathname });
      document.getElementById('bro-done-name')!.textContent = d.name.trim().split(/\s+/)[0] + '.';
      document.getElementById('bro-done-email')!.textContent = d.email.trim();
      stepForm.hidden = true;
      stepDone.hidden = false;
    } else {
      err.textContent = 'Sorry, your request could not be sent. Please try again, or email us at ' + EMAIL_TO + '.';
    }
  });
</script>
