---
import { company } from '../data/site';
---
<!--
  Brochure download pop-up. Any element with the attribute  data-brochure
  opens it. The visitor's details are emailed via Web3Forms (a lead), then
  the brochure downloads.
-->
<dialog id="brochure-modal" class="bro-modal" aria-labelledby="bro-title">
  <button class="bro-close" type="button" aria-label="Close" data-bro-close>×</button>
  <span class="label bro-over">Company Brochure</span>
  <h2 id="bro-title" class="bro-title">Download our <em>brochure</em></h2>
  <p class="bro-sub">
    Our products, quality standards and how we work — in one PDF. Tell us who you are and the download starts right away.
  </p>
  <form id="brochure-form" class="bro-form" novalidate>
    <input type="hidden" name="access_key" value={company.web3formsKey} />
    <input type="hidden" name="subject" value="Brochure Download — HKM Venture Global Website" />
    <input type="hidden" name="from_name" value="HKM Venture Global Website" />
    <input type="checkbox" name="botcheck" style="display:none;" />
    <div class="bro-row">
      <label class="bro-field">
        <span class="label">Full Name *</span>
        <input type="text" name="name" required autocomplete="name" placeholder="Your name" />
      </label>
      <label class="bro-field">
        <span class="label">Company *</span>
        <input type="text" name="company" required autocomplete="organization" placeholder="Your company" />
      </label>
    </div>
    <div class="bro-row">
      <label class="bro-field">
        <span class="label">Business Email *</span>
        <input type="email" name="email" required autocomplete="email" placeholder="you@company.com" />
      </label>
      <label class="bro-field">
        <span class="label">Country</span>
        <input type="text" name="country" autocomplete="country-name" placeholder="e.g. Ghana" />
      </label>
    </div>
    <p class="bro-error" id="bro-error" role="alert"></p>
    <button type="submit" class="btn btn-dark bro-submit">Download Brochure ↓</button>
  </form>
  <a id="bro-file" href={company.brochureUrl} download hidden>Brochure</a>
</dialog>

<style>
  .bro-modal {
    margin: auto;
    width: min(560px, calc(100vw - 32px));
    max-height: calc(100vh - 32px);
    border: 1px solid var(--outline-variant);
    border-radius: 4px;
    background: var(--surface);
    color: var(--on-surface);
    padding: 44px 40px 40px;
    box-shadow: 0 30px 80px rgba(0,0,0,0.35);
  }
  .bro-modal::backdrop { background: rgba(8, 7, 6, 0.7); backdrop-filter: blur(4px); }

  .bro-close {
    position: absolute;
    top: 14px; right: 18px;
    background: none; border: none;
    font-size: 28px; line-height: 1;
    color: var(--outline);
    cursor: pointer;
  }
  .bro-close:hover { color: var(--on-surface); }

  .bro-over { color: var(--primary); display: block; margin-bottom: 14px; }
  .bro-title { font-size: 36px; line-height: 1.1; letter-spacing: -0.02em; margin-bottom: 12px; }
  .bro-title em { font-style: italic; color: var(--primary); }
  .bro-sub { font-size: 14px; line-height: 1.7; color: var(--on-surface-variant); margin-bottom: 28px; }

  .bro-form { display: flex; flex-direction: column; gap: 20px; }
  .bro-row { display: flex; gap: 20px; }
  .bro-row > * { flex: 1; min-width: 0; }
  .bro-field { display: flex; flex-direction: column; gap: 6px; }
  .bro-field .label { font-size: 9px; letter-spacing: 0.18em; color: var(--outline); }
  .bro-field input {
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--outline-variant);
    padding: 9px 0;
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--on-surface);
    outline: none;
    border-radius: 0;
  }
  .bro-field input:focus { border-bottom-color: var(--primary); }
  .bro-field input.invalid { border-bottom-color: #ba1a1a; }
  .bro-error { font-size: 13px; color: #ba1a1a; min-height: 18px; }
  .bro-submit { align-self: flex-start; }

  @media (max-width: 600px) {
    .bro-modal { padding: 40px 22px 28px; }
    .bro-row { flex-direction: column; }
    .bro-title { font-size: 30px; }
  }
</style>

<script>
  const modal = document.getElementById('brochure-modal') as HTMLDialogElement;
  const form = document.getElementById('brochure-form') as HTMLFormElement;
  const err = document.getElementById('bro-error')!;
  const file = document.getElementById('bro-file') as HTMLAnchorElement;

  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest('[data-brochure]');
    if (t) {
      e.preventDefault();
      modal.showModal();
    }
    if ((e.target as HTMLElement).closest('[data-bro-close]')) modal.close();
  });
  modal.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });

  form.querySelectorAll('input').forEach((i) =>
    i.addEventListener('input', () => { i.classList.remove('invalid'); err.textContent = ''; })
  );

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const required = [...form.querySelectorAll('input[required]')] as HTMLInputElement[];
    const bad = required.filter((i) => !i.value.trim() || (i.type === 'email' && !i.checkValidity()));
    bad.forEach((i) => i.classList.add('invalid'));
    if (bad.length) {
      err.textContent = 'Please fill in your name, company and a valid email.';
      return;
    }
    const btn = form.querySelector('.bro-submit') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Preparing…';
    try {
      await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
    } catch (_) { /* download anyway */ }
    file.click();
    btn.textContent = 'Downloaded ✓';
    setTimeout(() => {
      modal.close();
      form.reset();
      btn.disabled = false;
      btn.textContent = 'Download Brochure ↓';
    }, 1400);
  });
</script>
