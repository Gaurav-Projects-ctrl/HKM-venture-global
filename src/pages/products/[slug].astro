---
import VerticalPage from '../../components/VerticalPage.astro';
import { verticals, type Vertical } from '../../data/site';

export function getStaticPaths() {
  return verticals.map((v) => ({ params: { slug: v.slug }, props: { v } }));
}
const { v } = Astro.props as { v: Vertical };
---
<VerticalPage v={v} showPresence={v.slug === 'pharmaceuticals'} />
