---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import PageHeader from '../../components/PageHeader.astro';
import CTA from '../../components/CTA.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import { verticals, waLink, type Vertical } from '../../data/site';
import SectionImage from '../../components/SectionImage.astro';
import SectionBg from '../../components/SectionBg.astro';
import { hasImage } from '../../lib/images';

export function getStaticPaths() {
  return verticals.map((v) => ({ params: { slug: v.slug }, props: { v } }));
}
const { v } = Astro.props as { v: Vertical };
const others = verticals.filter((o) => o.slug !== v.slug);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: v.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Layout title={v.metaTitle} description={v.metaDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Nav />
  <main>
    <PageHeader
      overline={`Category ${v.index} · Export from India`}
      title={v.title}
      titleEm={v.titleEm}
      sub={v.heroSub}
      crumbs={[{ label: 'Products', href: '/products' }, { label: v.short }]}
      primaryLabel="Request a Quote"
      primaryHref="#contact"
      image={v.slug}
    />

    <!-- Intro -->
    <section class="section-pad v-intro">
      <div class="container split-media split-media--img-right">
        <div class="split-media__img">
          <SectionImage name={`${v.slug}-overview`} alt={`${v.title} — sourcing and quality checks`} fill />
        </div>
        <div class="split-media__text reveal">
          <span class="label v-label">Overview</span>
          <div class="divider"></div>
          <h2 class="v-h2 v-h2--spaced">Sourced with care.<br/><em>Shipped with proof.</em></h2>
          {v.intro.map((p) => <p class="v-body">{p}</p>)}
          {v.forms && (
            <div class="v-forms">
              <span class="label v-mini">Dosage forms</span>
              <ul class="chips">
                {v.forms.map((f) => <li>{f}</li>)}
              </ul>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- Product range -->
    <section class="section-pad v-range" id="range">
      <div class="container">
        <div class="v-head reveal">
          <span class="label v-label">Product Range</span>
          <div class="divider"></div>
          <h2 class="v-h2">What we <em>supply</em></h2>
        </div>
        <div class="range-grid">
          {v.groups.map((g, i) => (
            <article class="range-card reveal">
              <span class="label range-num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="range-title">{g.name}</h3>
              {g.note && <p class="range-note">{g.note}</p>}
              <ul class="range-items">
                {g.items.map((it) => <li>{it}</li>)}
              </ul>
            </article>
          ))}
        </div>
        <div class="range-foot reveal">
          <p>{v.groupsNote}</p>
          <div class="range-btns">
            <a class="btn btn-dark" href={waLink(`Hello HKM Venture Global, please share your full ${v.short} product list.`)} target="_blank" rel="noopener">
              Request Full Product List
            </a>
            <a class="btn btn-outline" href="#" data-brochure>Download Brochure</a>
          </div>
        </div>
      </div>
    </section>

    <!-- What we offer -->
    <section class="section-pad v-offer">
      <div class="container v-offer-grid">
        <div class="reveal stack-fill">
          <span class="label v-label gold">How We Work</span>
          <div class="divider gold"></div>
          <h2 class="v-h2 light">More than<br/><em>a supplier</em></h2>
          <p class="v-body light">
            We are new, so we ask you to judge us on how we work: the manufacturers we choose, the documents we provide and how quickly we answer.
          </p>
          <SectionImage name={`${v.slug}-work`} alt={`${v.title} — storage and handling before export`} fill class="v-fill-img" />
        </div>
        <div class="offer-list">
          {v.services.map((s) => (
            <div class="offer-item reveal">
              <div class="offer-dash">—</div>
              <div>
                <h3 class="offer-title">{s.title}</h3>
                <p class="offer-body">{s.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Documentation -->
    <section class="section-pad v-docs">
      <div class="container">
        <div class="v-head reveal">
          <span class="label v-label">Documentation</span>
          <div class="divider"></div>
          <h2 class="v-h2">Every document, <em>every shipment</em></h2>
          <p class="v-body narrow">Paperwork is where imports get stuck. These documents come with your order as standard, so your registration, customs clearance and quality approvals move without delays.</p>
        </div>
        <div class="docs-grid">
          {v.documents.map((d) => (
            <div class="doc reveal">
              <span class="doc-tick" aria-hidden="true">✓</span>
              <div>
                <h3 class="doc-name">{d.name}</h3>
                <p class="doc-detail">{d.detail}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Markets -->
    <section class:list={['v-market', { 'has-img': hasImage(`${v.slug}-market`) }]}>
      <SectionBg name={`${v.slug}-market`} shade={0.7} />
      <div class="container v-market-inner reveal">
        <span class="label v-label gold">Markets</span>
        <h2 class="v-market-title">{v.markets.title}</h2>
        <p class="v-market-body">{v.markets.body}</p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section-pad v-faq">
      <div class="container v-faq-grid">
        <div class="reveal">
          <span class="label v-label">FAQ</span>
          <div class="divider"></div>
          <h2 class="v-h2">Common <em>questions</em></h2>
          <p class="v-body">Something else? <a href={waLink()} target="_blank" rel="noopener">Ask us on WhatsApp</a> — we reply within 24 hours.</p>
        </div>
        <div class="faq-list">
          {v.faqs.map((f, i) => (
            <details class="faq reveal" open={i === 0}>
              <summary>{f.q}<span class="faq-plus" aria-hidden="true">+</span></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Other verticals -->
    <section class="v-others">
      <div class="container">
        <span class="label v-label">Also From HKM</span>
        <div class="others-grid">
          {others.map((o) => (
            <a href={`/products/${o.slug}`} class="other-card">
              <span class="other-icon">{o.icon}</span>
              <span class="other-title">{o.short}</span>
              <span class="other-body">{o.cardBody}</span>
              <span class="label other-link">Explore →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <CTA primaryHref="#contact" />
    <Contact product={v.slug} />
  </main>
  <Footer />
</Layout>

<style>
  .v-label { color: var(--primary); display: block; margin-bottom: 20px; }
  .v-label.gold { color: var(--hero-glow); }
  .divider.gold { background: var(--hero-glow); opacity: 0.6; }
  .v-mini { color: var(--outline); display: block; margin-bottom: 14px; font-size: 9px; }
  .v-h2 {
    font-size: clamp(34px, 4vw, 52px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--on-surface);
  }
  .v-h2 em { font-style: italic; color: var(--primary); }
  .v-h2.light { color: #f3f0ec; }
  .v-h2.light em { color: var(--inverse-primary); }
  .v-body { font-size: 16px; line-height: 1.8; color: var(--on-surface-variant); margin-bottom: 20px; }
  .v-body.light { color: rgba(243,240,236,0.6); margin-top: 24px; }
  .v-body.narrow { max-width: 640px; margin-top: 20px; }
  .v-body a { color: var(--primary); }

  .v-intro { border-bottom: 1px solid var(--outline-variant); }
  .v-intro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; }
  .v-forms { margin-top: 28px; padding-top: 28px; border-top: 1px solid var(--outline-variant); }
  .chips { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips li {
    font-size: 13px;
    padding: 6px 14px;
    border: 1px solid var(--outline-variant);
    border-radius: 999px;
    color: var(--on-surface-variant);
    background: var(--surface-low);
  }

  .v-range { background: var(--surface-low); }
  .v-head { margin-bottom: 56px; }
  .range-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .range-card {
    background: var(--surface);
    border: 1px solid var(--outline-variant);
    border-radius: 4px;
    padding: 30px 28px;
    transition: border-color 0.3s, transform 0.3s;
  }
  .range-card:hover { border-color: rgba(117,90,43,0.4); }
  .range-num { color: var(--outline); font-size: 9px; }
  .range-title { font-size: 24px; line-height: 1.2; margin: 10px 0 14px; color: var(--on-surface); }
  .range-note { font-size: 13px; font-style: italic; color: var(--primary); margin: -6px 0 14px; }
  .range-items {
    list-style: none;
    display: flex; flex-direction: column; gap: 8px;
    border-top: 1px solid var(--outline-variant);
    padding-top: 16px;
  }
  .range-items li {
    font-size: 14px; line-height: 1.55;
    color: var(--on-surface-variant);
    padding-left: 14px; position: relative;
  }
  .range-items li::before { content: '—'; position: absolute; left: 0; color: var(--primary-container); font-size: 8px; top: 2px; }
  .range-foot {
    margin-top: 40px;
    display: flex; justify-content: space-between; align-items: center; gap: 32px;
    padding: 28px 32px;
    border: 1px dashed var(--outline-variant);
    border-radius: 4px;
  }
  .range-foot p { font-size: 14px; line-height: 1.7; color: var(--on-surface-variant); max-width: 560px; }
  .range-btns { display: flex; gap: 12px; flex-wrap: wrap; flex-shrink: 0; }

  .v-offer { background: var(--inverse-surface); }
  .v-offer-grid { display: grid; grid-template-columns: 1fr 1.3fr; gap: 80px; align-items: stretch; }
  .offer-list { display: flex; flex-direction: column; }
  .offer-item {
    display: flex; gap: 22px;
    padding: 26px 0;
    border-bottom: 1px solid rgba(229,193,136,0.12);
  }
  .offer-item:first-child { padding-top: 0; }
  .offer-dash { color: var(--inverse-primary); flex-shrink: 0; }
  .offer-title { font-size: 22px; color: #f3f0ec; margin-bottom: 8px; }
  .offer-body { font-size: 14px; line-height: 1.75; color: rgba(243,240,236,0.55); }

  .docs-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border-top: 1px solid var(--outline-variant); }
  .doc {
    display: flex; gap: 16px;
    padding: 28px 24px 28px 0;
    border-bottom: 1px solid var(--outline-variant);
  }
  .doc-tick {
    width: 26px; height: 26px; flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid var(--primary-container);
    color: var(--primary);
    display: flex; align-items: center; justify-content: center;
    font-size: 12px;
  }
  .doc-name { font-size: 19px; color: var(--on-surface); margin-bottom: 4px; line-height: 1.3; }
  .doc-detail { font-size: 13px; line-height: 1.65; color: var(--on-surface-variant); }

  .v-market {
    background: var(--hero-bg);
    padding: 96px 0;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .v-market::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(600px circle at 50% 120%, rgba(229,193,136,0.14), transparent 65%);
  }
  .v-market-inner { position: relative; z-index: 1; max-width: 760px; }
  .v-market.has-img { padding: 140px 0; }
  .v-market.has-img .v-market-body { color: rgba(245,240,232,0.82); }
  .v-h2--spaced { margin-bottom: 32px; }
  .v-offer-grid :global(.v-fill-img) { margin-top: 40px; min-height: 240px; }
  .v-market-title { font-size: clamp(32px, 4vw, 48px); color: var(--hero-text); line-height: 1.15; margin-bottom: 20px; }
  .v-market-body { font-size: 16px; line-height: 1.8; color: rgba(245,240,232,0.6); }

  .v-faq-grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: 80px; align-items: start; }
  .faq { border-bottom: 1px solid var(--outline-variant); }
  .faq:first-child { border-top: 1px solid var(--outline-variant); }
  .faq summary {
    list-style: none;
    cursor: pointer;
    display: flex; justify-content: space-between; gap: 24px; align-items: center;
    padding: 22px 0;
    font-family: var(--font-display);
    font-size: 21px;
    color: var(--on-surface);
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq-plus { font-family: var(--font-body); font-size: 20px; color: var(--primary); transition: transform 0.25s; flex-shrink: 0; }
  .faq[open] .faq-plus { transform: rotate(45deg); }
  .faq p { font-size: 15px; line-height: 1.8; color: var(--on-surface-variant); padding: 0 40px 24px 0; }

  .v-others { background: var(--surface-low); padding: 80px 0; border-top: 1px solid var(--outline-variant); }
  .others-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .other-card {
    display: flex; flex-direction: column; gap: 10px;
    padding: 32px;
    background: var(--surface);
    border: 1px solid var(--outline-variant);
    border-radius: 4px;
    text-decoration: none;
    transition: border-color 0.3s, transform 0.3s;
  }
  .other-card:hover { border-color: var(--primary); transform: translateY(-3px); }
  .other-icon { color: var(--primary-container); font-size: 18px; }
  .other-title { font-family: var(--font-display); font-size: 28px; color: var(--on-surface); }
  .other-body { font-size: 14px; line-height: 1.7; color: var(--on-surface-variant); }
  .other-link { color: var(--primary); margin-top: 6px; }

  @media (max-width: 1000px) {
    .range-grid, .docs-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 900px) {
    .v-intro-grid, .v-offer-grid, .v-faq-grid { grid-template-columns: 1fr; gap: 40px; }
    .v-offer-grid :global(.v-fill-img) { min-height: 0; }
    .range-foot { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 640px) {
    .range-grid, .docs-grid, .others-grid { grid-template-columns: 1fr; }
    .faq summary { font-size: 18px; }
    .faq p { padding-right: 0; }
    .range-btns { flex-direction: column; width: 100%; }
    .range-btns .btn { justify-content: center; }
  }
</style>
