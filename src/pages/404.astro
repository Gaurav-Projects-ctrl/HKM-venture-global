---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Page not found | HKM Venture Global" noindex>
  <Nav />
  <main>
    <PageHeader
      overline="404"
      title="This page has"
      titleEm="shipped elsewhere."
      sub="The page you were looking for doesn’t exist. Try our products, or get in touch and we’ll help directly."
      primaryLabel="View Products"
      primaryHref="/products"
    />
  </main>
  <Footer />
</Layout>
